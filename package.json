{
  "name": "struq-voice",
  "version": "0.0.0",
  "private": true,
  "description": "Tray-resident Windows dictation. Hold a key, speak, release, text lands at the caret.",
  "main": "./out/main/index.cjs",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite build && electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "node scripts/build-installer.mjs",
    "release": "pnpm dist && pnpm release:sign && pnpm release:verify",
    "release:sign": "node scripts/sign-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:cut": "node scripts/release-cut.mjs",
    "release:auto": "node scripts/release-auto.mjs",
    "release:dry": "node scripts/release-auto.mjs --dry-run",
    "ship": "pnpm release && pnpm release:publish",
    "ship:auto": "node scripts/release-auto.mjs",
    "postinstall": "node scripts/rebuild-native-modules.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sherpa-onnx-node": "^1.13.4",
    "sherpa-onnx-win-x64": "^1.13.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uiohook-napi": "^1.5.5",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.1",
    "playwright": "1.62.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
